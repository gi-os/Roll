<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shake-to-report, and nothing else. Roll had no network permission at all before
         this; it opens a socket only after you tap SEND on a report you wrote yourself.
         See report/Reports.kt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The roll above the viewfinder is the device's real camera roll, not a private
         folder, so the whole of DCIM has to be readable. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!--
      The roll shows clips as well as stills, so it needs the video half of the granular media
      permissions too. Without it a video this app recorded is still visible - an app always owns
      what it inserted - but anything recorded by anything else is invisible to the query and
      unplayable in the viewer, which reads as the roll losing videos at random.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Where a photograph was taken, for the map.

      Coarse and fine are both declared and neither is required: a coarse fix is enough to put a
      photograph in the right place on a map at any zoom a person actually reads, and asking only
      for coarse is a smaller thing to ask for. Fine is used when it has been granted anyway.

      ACCESS_MEDIA_LOCATION is the one that surprises people, and it is about *reading* rather than
      writing: since Android 10 MediaStore strips GPS out of anything it hands an app unless the
      original is asked for. Without it the map is empty in a way that looks like the photographs
      have no location rather than like a permission is missing.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!--
        The send picker is a list of people, not a grid of apps. Android gives a third-party app
        no way to read another app's sharing shortcuts — the row of faces in the system chooser
        is published by the sending app for the system's own UI — so to ask "who is this photo
        for" at all, this app has to read the address book itself. Read on the phone, never sent
        anywhere; asked for at the moment the picker is first opened rather than at launch.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Video mode, and only asked for when you switch to it. A recording with no sound is
         worth more than a permission dialog in front of the thing you were filming. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        The panel is a full-colour AMOLED; Light's black and white is the accessibility
        daltonizer pinned to monochromacy. Lifting it while the viewfinder is up is what makes
        the picture appear in colour, and writing that setting needs this. It is
        signature|privileged|development, so it cannot be granted by the installer and is not
        requested at runtime — one adb line grants it, and without it the app just stays grey:

            adb shell pm grant com.gios.lightcamera android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        **Package visibility.** From Android 11 an app cannot see another app's activities unless it says
        which ones it is looking for, and `resolveActivity` simply returns null for everything else. That
        is why the send button reported "LightChat can't receive photos" on a phone with LightChat
        installed: the intent resolved fine, we just could not see that it did.
    -->
    <queries>
        <package android:name="com.gios.lightchat" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- Several photographs at once is a different action with different extras, and an app
             that only registered for the singular one must not be sent the plural. So it has to
             be resolvable separately. -->
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="image/*" />
        </intent>
        <!--
            QR mode hands a scanned payload to whatever handles its scheme. Declared here so the
            phone's own handlers are visible to this app at all; the launch itself is a plain
            `startActivity` in a `runCatching`, because `resolveActivity` answering null is not
            evidence of anything under package visibility. The scheme list is closed on purpose and
            matches `Codes.openable` — a QR code is a string a stranger printed on a wall, and
            `intent:` URIs are the reason that matters.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".RollApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Roll"
        android:supportsRtl="false"
        android:theme="@style/Theme.LightCamera">

        <!--
            Everything below the launcher filter is what makes this installable *as the
            phone's camera* rather than as another app that happens to have a viewfinder.

            - STILL_IMAGE_CAMERA is what the hardware camera key and LightOS's own
              shortcut resolve to. With two apps claiming it the system shows a chooser
              with a "always" option, which is how this becomes the default.
            - IMAGE_CAPTURE is the contract other apps use for "take a photo" — it must
              honour EXTRA_OUTPUT and return a result, which MainActivity does.
            - The *_SECURE variants are the lock-screen entry points; showWhenLocked plus
              turnScreenOn is what lets the camera key work with the phone locked, and
              the app deliberately refuses to open the roll in that state.
        -->
        <!--
          The photographs you starred, offered to the rest of the collection.
        
          Read-only, and the smallest useful thing: a list of file names. It exists because a star is
          the one fact about a photograph that only this app knows — everything else another app
          wants is already in MediaStore, which is why LightNotebook can put your pictures on its
          calendar with no bridge at all. MediaStore's IS_FAVORITE is effectively writable only by
          the system gallery, so the list lives here and has to be handed over deliberately.
        -->
        <provider
            android:name=".share.StarsProvider"
            android:authorities="${applicationId}.stars"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Roll"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.LightCamera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:priority="1">
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <action android:name="android.intent.action.CAMERA_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:priority="1">
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <action android:name="android.media.action.IMAGE_CAPTURE_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            LightSync finds apps by provider authority suffix, so this entry is the whole
            registration. exported=true is required for a cross-app ContentProvider and is not
            the trust boundary: LightSyncBackup rejects any caller that is not LightSync by
            package and by signing certificate, checked on every call.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />

    </application>
</manifest>
